rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(a, b)))
        && get(/databases/$(database)/documents/friendships/$(pairId(a, b))).data.status == 'accepted';
    }
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /friendContacts/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || areFriends(request.auth.uid, userId));
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email'])
        && (request.resource.data.email == null || request.resource.data.email == request.auth.token.email);
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /friendPresence/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || areFriends(request.auth.uid, userId));
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool;
      allow delete: if signedIn() && request.auth.uid == userId;
      match /sessions/{sessionId} {
        allow read: if signedIn() && (request.auth.uid == userId ||
          (areFriends(request.auth.uid, userId) && get(/databases/$(database)/documents/friendPresence/$(userId)).data.enabled == true));
        allow create, update: if signedIn() && request.auth.uid == userId
          && get(/databases/$(database)/documents/friendPresence/$(userId)).data.enabled == true
          && request.resource.data.keys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'requester', 'recipient', 'status'])
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.recipient != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.requester in request.resource.data.participants
        && request.resource.data.recipient in request.resource.data.participants
        && friendshipId == pairId(request.resource.data.requester, request.resource.data.recipient)
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && request.auth.uid == resource.data.recipient
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /users/{userId}/sharedWorkouts/{shareId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && areFriends(request.auth.uid, userId)
        && request.resource.data.keys().hasOnly(['from', 'workout', 'sharedAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.workout.keys().hasAll(['id', 'name', 'steps'])
        && request.resource.data.workout.name is string
        && request.resource.data.workout.steps is list;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
